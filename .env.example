DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=False

DATABASE_URL=postgresql://postgres:postgres@db:5432/outdoor_media
POSTGRES_DB=outdoor_media
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_OVERDUE_CHECK_HOUR=1
CELERY_REQUEST_LOG_CLEANUP_HOUR=2
OMMS_ENABLE_BACKGROUND_JOBS=True

ACCESS_TOKEN_LIFETIME_MINUTES=20
SESSION_INACTIVITY_TIMEOUT_HOURS=72
REFRESH_COOKIE_MAX_AGE_SECONDS=259200
AUTH_REFRESH_COOKIE_NAME=omms_refresh_session
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAMESITE=None
AUTH_REFRESH_COOKIE_SECURE=True
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
OMMS_PUBLIC_REGISTRATION_ENABLED=False
OMMS_API_REQUEST_LOGGING_ENABLED=True
OMMS_SLOW_REQUEST_MS=1000
OMMS_REQUEST_LOG_RETENTION_DAYS=30
OMMS_QUERY_TIMING_ENABLED=False
OMMS_DASHBOARD_CACHE_SECONDS=60
OMMS_APP_VERSION=
OMMS_GIT_COMMIT=
OMMS_ENVIRONMENT_NAME=production
OMMS_BACKEND_PUBLIC_BASE_URL=https://omms-backend.onrender.com

# API throttling. Tune per deployment traffic patterns.
DRF_ANON_THROTTLE_RATE=300/hour
DRF_USER_THROTTLE_RATE=3000/hour
DRF_AUTH_TOKEN_THROTTLE_RATE=30/minute
DRF_REGISTRATION_THROTTLE_RATE=20/hour
DRF_SETUP_OTP_THROTTLE_RATE=30/hour
DRF_PUBLIC_ESTIMATE_THROTTLE_RATE=120/hour
DRF_PUBLIC_ESTIMATE_ACTION_THROTTLE_RATE=20/hour
DRF_PUBLIC_CAMPAIGN_THROTTLE_RATE=240/hour
DRF_PUBLIC_ISSUE_REPORT_THROTTLE_RATE=60/hour
DRF_UPLOAD_THROTTLE_RATE=120/hour

# Billing tax configuration. Do not leave GST-enabled suppliers without a rate source.
BILLING_DEFAULT_GST_RATE=
BILLING_GST_RATE_BY_SAC=

DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_PUBLIC_BASE_URL=
USE_S3_MEDIA=False

# Optional: external object storage
DJANGO_DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
DJANGO_STATICFILES_STORAGE=whitenoise.storage.CompressedManifestStaticFilesStorage
AWS_ACCESS_KEY_ID=
