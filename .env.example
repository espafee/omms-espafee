AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=True
AWS_S3_OBJECT_PARAMETERS_CACHE_CONTROL=

# Private documents (invoices, contracts, receipts, internal files)
DJANGO_PRIVATE_DOCUMENT_STORAGE=core.storage_backends.PrivateDocumentStorage
AWS_PRIVATE_STORAGE_BUCKET_NAME=
AWS_PRIVATE_S3_ENDPOINT_URL=
AWS_PRIVATE_S3_REGION_NAME=
AWS_PRIVATE_ACCESS_KEY_ID=
AWS_PRIVATE_SECRET_ACCESS_KEY=
