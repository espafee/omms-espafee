FRONTEND_PUBLIC_BASE_URL=https://omms.vercel.app
NOTIFICATION_COMPANY_NAME=OMMS Control
OMMS_ENCRYPTION_KEY=replace-with-a-long-random-secret-for-smtp-password-encryption

# Production reminders:
# - Use HTTPS-only origins in DJANGO_CSRF_TRUSTED_ORIGINS and DJANGO_CORS_ALLOWED_ORIGINS.
# - Set DJANGO_SECURE_SSL_REDIRECT=True behind a correctly configured HTTPS proxy.
# - Set non-zero DJANGO_HSTS_SECONDS only after HTTPS is verified end-to-end.

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
